# Copy this file to .env (in the same folder) and fill in real values.
# .env must never be committed to version control.

# Gmail account used to send approval emails (sender and recipient are the
# same address for now: ai@ms2.co.in)
GMAIL_USER=ai@ms2.co.in
# Generate at https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_APP_PASSWORD=

# Address that receives the Approve/Reject email
APPROVAL_RECIPIENT=ai@ms2.co.in

# Local approval server settings
APPROVAL_SERVER_HOST=localhost
APPROVAL_SERVER_PORT=8765
